---
import { portfolio } from '../data/content';
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
---

<section id="portfolio" class="section border-t border-[var(--color-line)] bg-[var(--color-bg-soft)]">
  <div class="container-x">
    <SectionHeading index="02" eyebrow={portfolio.eyebrow} heading={portfolio.heading}>
      <p class="measure mt-5 text-[var(--color-muted)]">{portfolio.intro}</p>
    </SectionHeading>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {portfolio.projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </div>
</section>

---
interface Props {
  eyebrow?: string;
  heading: string;
  align?: 'left' | 'center';
}
const { eyebrow, heading, align = 'left' } = Astro.props;
---

<div class={`reveal max-w-2xl ${align === 'center' ? 'mx-auto text-center' : ''}`}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{heading}</h2>
  <slot />
</div>

---
import { footer, site } from '../data/content';

// Build a "2025" or "2025–2026" copyright range. Astro renders at build time,
// so this resolves to the build year — fine for a static marketing site.
const buildYear = new Date().getFullYear();
const yearLabel =
  buildYear > footer.startYear ? `${footer.startYear}–${buildYear}` : `${footer.startYear}`;
---

<footer class="border-t border-[var(--color-line)] bg-[var(--color-bg-soft)]">
  <div
    class="container-x flex flex-col items-start justify-between gap-6 py-12 sm:flex-row sm:items-center"
  >
    <div class="flex items-center gap-2.5">
      <span
        class="grid h-6 w-6 place-items-center rounded-[3px] bg-[var(--color-ink)] font-mono text-[0.65rem] font-bold text-white"
        aria-hidden="true">10</span
      >
      <div class="text-sm">
        <p class="font-semibold">{site.name}</p>
        <p class="text-[var(--color-faint)]">{footer.tagline}</p>
      </div>
    </div>

    <nav class="flex flex-wrap items-center gap-x-7 gap-y-2 text-sm" aria-label="Footer">
      {
        footer.links.map((link) => (
          <a
            href={link.href}
            class="text-[var(--color-muted)] transition-colors hover:text-[var(--color-ink)]"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={`mailto:${site.email}`}
        class="font-mono text-[var(--color-muted)] transition-colors hover:text-[var(--color-ink)]"
      >
        {site.email}
      </a>
    </nav>
  </div>

  <div class="container-x border-t border-[var(--color-line)] py-6">
    <p class="eyebrow">
      © {yearLabel} {site.name}. All rights reserved.
    </p>
  </div>
</footer>

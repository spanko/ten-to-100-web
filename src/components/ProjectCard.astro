---
import type { Project } from '../data/content';

interface Props {
  project: Project;
  index?: number;
}
const { project, index = 0 } = Astro.props;

// Stage -> pill styling. Keyed to the constrained `Stage` union.
// Dark, saturated text on a light tint for AA contrast on white cards.
const stageStyles: Record<Project['stage'], string> = {
  Concept: 'text-[#6d28d9] bg-[#6d28d9]/10 border-[#6d28d9]/20',
  Prototype: 'text-[#0369a1] bg-[#0369a1]/10 border-[#0369a1]/20',
  'In development': 'text-[#047857] bg-[#047857]/10 border-[#047857]/20',
  Live: 'text-[#15803d] bg-[#15803d]/10 border-[#15803d]/20',
};
const dotColor: Record<Project['stage'], string> = {
  Concept: '#7c3aed',
  Prototype: '#0284c7',
  'In development': '#059669',
  Live: '#16a34a',
};
---

<article
  class="card card-hover reveal flex h-full flex-col p-6 sm:p-7"
  style={`transition-delay: ${index * 70}ms;`}
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-xl font-semibold">{project.name}</h3>
    <span
      class={`inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[0.68rem] ${stageStyles[project.stage]}`}
    >
      <span
        class="h-1.5 w-1.5 rounded-full"
        style={`background:${dotColor[project.stage]}`}
        aria-hidden="true"></span>
      {project.stage}
    </span>
  </div>

  <p class="mt-1.5 text-[var(--color-ink)]/90">{project.pitch}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--color-muted)]">
    {project.blurb}
  </p>

  <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tags">
    {project.tags.map((tag) => <li class="chip">{tag}</li>)}
  </ul>
</article>

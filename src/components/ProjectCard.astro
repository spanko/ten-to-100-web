---
import type { Project } from '../data/content';

interface Props {
  project: Project;
  index?: number;
}
const { project, index = 0 } = Astro.props;

// Stage -> marker dot. The label itself stays in the muted mono voice so the
// four cards read as a set; only the dot carries the color.
const dotColor: Record<Project['stage'], string> = {
  Concept: '#6b7280',
  Prototype: '#17408c',
  'In development': '#0e7a5f',
  Live: '#15803d',
};
---

<article
  class="card card-hover reveal flex h-full flex-col p-7 sm:p-8"
  style={`transition-delay: ${index * 60}ms;`}
>
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-xl">{project.name}</h3>
    <span class="eyebrow flex shrink-0 items-center gap-1.5">
      <span
        class="h-1.5 w-1.5 rounded-full"
        style={`background:${dotColor[project.stage]}`}
        aria-hidden="true"></span>
      {project.stage}
    </span>
  </div>

  <p class="mt-3 text-[0.95rem] font-medium text-[var(--color-ink)]">{project.pitch}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--color-muted)]">
    {project.blurb}
  </p>

  <div class="mt-7 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-[var(--color-line)] pt-4">
    <ul class="flex flex-wrap items-center" aria-label="Tags">
      {project.tags.map((tag) => <li class="chip">{tag}</li>)}
    </ul>

    {
      project.link && (
        <a
          href={project.link.href}
          class="link inline-flex shrink-0 items-center gap-1.5 font-mono text-xs"
          rel="noopener noreferrer"
        >
          {project.link.label}
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path
              d="M2.5 7.5 7.5 2.5M3.5 2.5h4v4"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="sr-only">(opens {project.name}’s site)</span>
        </a>
      )
    }
  </div>
</article>

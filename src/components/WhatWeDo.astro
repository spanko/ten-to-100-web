---
import { whatWeDo } from '../data/content';
import SectionHeading from './SectionHeading.astro';
---

<section id="what-we-do" class="section">
  <div class="container-x">
    <SectionHeading index="01" eyebrow={whatWeDo.eyebrow} heading={whatWeDo.heading}>
      <div class="measure mt-6 space-y-4 text-[var(--color-muted)]">
        {whatWeDo.body.map((para) => <p>{para}</p>)}
      </div>
    </SectionHeading>

    <!-- Pillars sit in open columns divided by hairlines rather than in cards:
         they are an argument in three parts, not three separate objects. -->
    <div class="mt-16 grid gap-x-10 gap-y-10 border-t border-[var(--color-line)] pt-10 sm:grid-cols-3">
      {
        whatWeDo.pillars.map((pillar, i) => (
          <div
            class={`reveal ${i > 0 ? 'sm:border-l sm:border-[var(--color-line)] sm:pl-10' : ''}`}
            style={`transition-delay: ${i * 70}ms;`}
          >
            <span class="eyebrow text-[var(--color-ink)]">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-lg">{pillar.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-[var(--color-muted)]">{pillar.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

---
import { labs } from '../data/content';
import SectionHeading from './SectionHeading.astro';
---

<!--
  LABS — a deliberately lighter strip for small experiments.
  Ships OFF (flags.showLabs = false) and pre-filled with clearly-marked
  PLACEHOLDER cards. Populate `labs.entries` in src/data/content.ts and flip
  the flag to publish.
-->
<section id="labs" class="section bg-[var(--color-bg-soft)]">
  <div class="container-x">
    <SectionHeading eyebrow={labs.eyebrow} heading={labs.heading}>
      <p class="mt-4 text-[var(--color-muted)]">{labs.intro}</p>
    </SectionHeading>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        labs.entries.map((entry, i) => (
          <article
            class="reveal rounded-xl border border-dashed border-[var(--color-line)] bg-transparent p-5"
            style={`transition-delay: ${i * 70}ms;`}
          >
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-medium text-[var(--color-ink)]/90">{entry.name}</h3>
              <span class="chip border-dashed">placeholder</span>
            </div>
            <p class="mt-2 text-sm text-[var(--color-muted)]">{entry.blurb}</p>
            {entry.tags?.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
                {entry.tags.map((tag) => (
                  <li class="chip">{tag}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

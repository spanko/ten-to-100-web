---
import { hero } from '../data/content';
---

<section id="top" class="border-b border-[var(--color-line)]">
  <div class="container-x pb-20 pt-24 md:pb-28 md:pt-32">
    <div class="grid gap-12 md:grid-cols-[1fr_auto] md:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow reveal">{hero.eyebrow}</p>

        <h1
          class="reveal mt-6 text-[2.5rem] leading-[1.08] sm:text-5xl md:text-[3.75rem]"
          style="transition-delay: 60ms;"
        >
          {hero.headlinePre}{' '}
          <span class="text-[var(--color-accent)]">{hero.emphasis}</span>{hero.headlinePost}
        </h1>

        <p
          class="reveal measure mt-7 text-lg leading-relaxed text-[var(--color-muted)]"
          style="transition-delay: 120ms;"
        >
          {hero.subhead}
        </p>

        <div
          class="reveal mt-10 flex flex-col gap-3 sm:flex-row"
          style="transition-delay: 180ms;"
        >
          <a href={hero.primaryCta.href} class="btn btn-primary w-full sm:w-auto">
            {hero.primaryCta.label}
          </a>
          <a href={hero.secondaryCta.href} class="btn btn-ghost w-full sm:w-auto">
            {hero.secondaryCta.label}
          </a>
        </div>
      </div>

      <!-- The 10 → 100 motif, set as a vertical marginal note on wide screens. -->
      <div
        class="reveal hidden shrink-0 md:block"
        style="transition-delay: 240ms;"
        aria-hidden="true"
      >
        <div class="flex items-center gap-3 font-mono">
          <span class="text-3xl font-semibold text-[var(--color-ink)]">10</span>
          <span class="h-px w-14 bg-[var(--color-line-strong)]"></span>
          <span class="text-3xl font-semibold text-[var(--color-accent)]">100</span>
        </div>
      </div>
    </div>
  </div>
</section>

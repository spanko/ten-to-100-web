---
import { contact, site } from '../data/content';
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(contact.emailSubject)}`;
---

<section id="contact" class="section">
  <div class="container-x">
    <div
      class="relative overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface)] p-8 text-center sm:p-12"
    >
      <div
        class="pointer-events-none absolute left-1/2 top-0 h-64 w-[36rem] max-w-full -translate-x-1/2 opacity-25 blur-3xl"
        style="background: radial-gradient(closest-side, var(--color-accent), transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto max-w-xl">
        <p class="eyebrow">{contact.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{contact.heading}</h2>
        <p class="mt-4 text-[var(--color-muted)]">{contact.body}</p>

        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href={mailto} class="btn btn-primary w-full sm:w-auto">
            Email us
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M2 4h12v8H2zM2 4l6 4 6-4"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href={mailto} class="font-mono text-sm text-[var(--color-muted)] underline-offset-4 hover:text-[var(--color-ink)] hover:underline">
            {contact.emailLabel}
          </a>
        </div>

        {
          contact.formEnabled && (
            <form
              class="mx-auto mt-10 grid max-w-md gap-3 text-left"
              action={contact.formEndpoint}
              method="POST"
            >
              <label class="text-sm">
                <span class="mb-1 block text-[var(--color-muted)]">Name</span>
                <input
                  type="text"
                  name="name"
                  required
                  class="w-full rounded-lg border border-[var(--color-line)] bg-[var(--color-bg)] px-3 py-2 text-[var(--color-ink)] focus:border-[var(--color-accent)]"
                />
              </label>
              <label class="text-sm">
                <span class="mb-1 block text-[var(--color-muted)]">Email</span>
                <input
                  type="email"
                  name="email"
                  required
                  class="w-full rounded-lg border border-[var(--color-line)] bg-[var(--color-bg)] px-3 py-2 text-[var(--color-ink)] focus:border-[var(--color-accent)]"
                />
              </label>
              <label class="text-sm">
                <span class="mb-1 block text-[var(--color-muted)]">Message</span>
                <textarea
                  name="message"
                  rows="4"
                  required
                  class="w-full rounded-lg border border-[var(--color-line)] bg-[var(--color-bg)] px-3 py-2 text-[var(--color-ink)] focus:border-[var(--color-accent)]"
                />
              </label>
              <button type="submit" class="btn btn-primary mt-1 justify-center">
                Send message
              </button>
            </form>
          )
        }
      </div>
    </div>
  </div>
</section>

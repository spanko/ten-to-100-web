---
import { contact, site } from '../data/content';
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(contact.emailSubject)}`;
---

<section id="contact" class="section border-t border-[var(--color-line)]">
  <div class="container-x">
    <div class="grid gap-10 md:grid-cols-2 md:items-start md:gap-16">
      <div class="reveal">
        <p class="eyebrow">{contact.eyebrow}</p>
        <h2 class="mt-4 text-3xl sm:text-[2.5rem]">{contact.heading}</h2>
        <p class="measure mt-5 text-[var(--color-muted)]">{contact.body}</p>
      </div>

      <div class="reveal md:pt-2" style="transition-delay: 80ms;">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
          <a href={mailto} class="btn btn-primary w-full sm:w-auto">Email us</a>
          <a href={mailto} class="link font-mono text-sm">{contact.emailLabel}</a>
        </div>

        {
          contact.formEnabled && (
            <form
              class="mt-10 grid max-w-md gap-4"
              action={contact.formEndpoint}
              method="POST"
            >
              <label class="text-sm">
                <span class="eyebrow mb-1.5 block">Name</span>
                <input
                  type="text"
                  name="name"
                  required
                  class="w-full rounded-[3px] border border-[var(--color-control)] bg-[var(--color-surface)] px-3 py-2 text-[var(--color-ink)] focus:border-[var(--color-accent)]"
                />
              </label>
              <label class="text-sm">
                <span class="eyebrow mb-1.5 block">Email</span>
                <input
                  type="email"
                  name="email"
                  required
                  class="w-full rounded-[3px] border border-[var(--color-control)] bg-[var(--color-surface)] px-3 py-2 text-[var(--color-ink)] focus:border-[var(--color-accent)]"
                />
              </label>
              <label class="text-sm">
                <span class="eyebrow mb-1.5 block">Message</span>
                <textarea
                  name="message"
                  rows="4"
                  required
                  class="w-full rounded-[3px] border border-[var(--color-control)] bg-[var(--color-surface)] px-3 py-2 text-[var(--color-ink)] focus:border-[var(--color-accent)]"
                />
              </label>
              <button type="submit" class="btn btn-primary mt-1 justify-center">
                Send message
              </button>
            </form>
          )
        }
      </div>
    </div>
  </div>
</section>

---
import { azure } from '../data/content';
import SectionHeading from './SectionHeading.astro';
---

<section id="azure" class="section border-t border-[var(--color-line)]">
  <div class="container-x">
    <SectionHeading index="03" eyebrow={azure.eyebrow} heading={azure.heading}>
      <p class="measure mt-6 text-[var(--color-muted)]">{azure.body}</p>
    </SectionHeading>

    <dl class="mt-14 grid gap-x-10 gap-y-9 border-t border-[var(--color-line)] pt-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        azure.items.map((item, i) => (
          <div
            class={`reveal ${i > 0 ? 'lg:border-l lg:border-[var(--color-line)] lg:pl-10' : ''}`}
            style={`transition-delay: ${i * 60}ms;`}
          >
            <dt class="font-semibold">{item.name}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{item.blurb}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

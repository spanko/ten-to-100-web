---
import { site, nav } from '../data/content';
---

<header
  class="sticky top-0 z-50 border-b border-[var(--color-line)] bg-[var(--color-bg)]/90 backdrop-blur-sm"
>
  <nav
    class="container-x flex h-16 items-center justify-between"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="flex items-center gap-2.5 font-semibold tracking-tight text-[var(--color-ink)]"
    >
      <span
        class="grid h-6 w-6 place-items-center rounded-[3px] bg-[var(--color-ink)] font-mono text-[0.65rem] font-bold text-white"
        aria-hidden="true">10</span
      >
      <span>{site.name}</span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        nav.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-ink)]"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="#contact"
      class="btn btn-ghost h-9 px-3.5 py-0 text-sm"
    >
      Get in touch
    </a>
  </nav>
</header>

---
import { team } from '../data/content';
import SectionHeading from './SectionHeading.astro';
---

<section id="team" class="section bg-[var(--color-bg-soft)]">
  <div class="container-x">
    <SectionHeading eyebrow={team.eyebrow} heading={team.heading} />

    <div class="mt-10 grid gap-6 md:grid-cols-[auto_1fr] md:items-start">
      <div class="card reveal flex max-w-md gap-5 p-6">
        <div
          class="grid h-16 w-16 shrink-0 place-items-center rounded-full bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-accent-2)] font-mono text-lg font-bold text-white"
          aria-hidden="true"
        >
          {team.founder.initials}
        </div>
        <div>
          <h3 class="text-lg font-semibold">{team.founder.name}</h3>
          <p class="eyebrow !text-[var(--color-faint)]">{team.founder.role}</p>
          <p class="mt-3 text-sm text-[var(--color-muted)]">{team.founder.bio}</p>
        </div>
      </div>

      <p class="reveal max-w-md self-center text-[var(--color-muted)] md:pl-4">
        {team.collaboratorsNote}
      </p>
    </div>
  </div>
</section>

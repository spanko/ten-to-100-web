---
import { team } from '../data/content';
import SectionHeading from './SectionHeading.astro';
---

<section id="team" class="section border-t border-[var(--color-line)] bg-[var(--color-bg-soft)]">
  <div class="container-x">
    <SectionHeading index="04" eyebrow={team.eyebrow} heading={team.heading} />

    <div
      class="mt-14 grid gap-10 border-t border-[var(--color-line)] pt-10 md:grid-cols-2 md:gap-16"
    >
      <p class="reveal text-lg leading-relaxed text-[var(--color-ink)]">
        {team.statement}
      </p>

      <p class="reveal text-sm leading-relaxed text-[var(--color-muted)] md:border-l md:border-[var(--color-line)] md:pl-16">
        {team.collaboratorsNote}
      </p>
    </div>
  </div>
</section>

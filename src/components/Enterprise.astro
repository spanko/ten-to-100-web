---
import { enterprise } from '../data/content';
import SectionHeading from './SectionHeading.astro';
---

<section id="enterprise" class="section">
  <div class="container-x">
    <div class="card reveal overflow-hidden p-8 sm:p-10 md:p-12">
      <div class="grid gap-8 md:grid-cols-2 md:items-center">
        <div>
          <SectionHeading eyebrow={enterprise.eyebrow} heading={enterprise.heading}>
            <p class="mt-5 text-[var(--color-muted)]">{enterprise.body}</p>
          </SectionHeading>
        </div>

        <ul class="grid gap-3">
          {
            enterprise.capabilities.map((cap) => (
              <li class="flex items-start gap-3 border-b border-[var(--color-line)] pb-3">
                <svg
                  class="mt-0.5 shrink-0 text-[var(--color-accent)]"
                  width="18"
                  height="18"
                  viewBox="0 0 20 20"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M4 10.5l3.5 3.5L16 6"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span class="text-sm">{cap}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
